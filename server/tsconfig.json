{
  "compilerOptions": {
    // package.json의 "type": "module"(ESM) 규칙을 그대로 따른다.
    "module": "nodenext",
    // Node 26은 최신 문법을 다 읽으므로 인쇄본(js)을 옛 문법으로 낮출 필요가 없다.
    "target": "esnext",

    // 원고의 기준 폴더. 이 tsconfig가 있는 server 폴더를 기준으로 폴더 구조를 그대로 보존한다.
    "rootDir": ".",
    // 인쇄본 보관함. git에는 올리지 않는다.
    "outDir": "./dist",

    // 업계 기준선인 깐깐한 검수. 그 바깥의 추가 검사(noUncheckedIndexedAccess 등)는 켜지 않기로 했다.
    "strict": true,
    // 이 파일은 검사 전용이다(npm run typecheck). 테스트까지 포함해 전부 검사하되
    // 인쇄본은 만들지 않는다. dist를 만드는 건 이 설정을 물려받아 테스트를 빼고
    // noEmit만 끄는 tsconfig.build.json의 일이다(2026-11-22).
    //
    // allowJs는 껐다(줄째로 지움). 파일을 하나씩 바꾸는 동안 .js와 .ts를 섞어
    // 빌드하려고 켰던 것인데, 서버 코드가 전부 .ts가 됐다.
    "noEmit": true,

    // TS 7은 기본값이 빈 배열이라, 적지 않으면 process 같은 Node 전역을 모른다.
    "types": ["node"],
    // node_modules 속 남의 타입 설명서끼리의 충돌은 검사하지 않는다.
    "skipLibCheck": true
  },
  // 검사에서 뺄 것 2개: 남의 코드, 인쇄본. 테스트는 이제 검사 대상이다 — vitest는
  // 타입을 지우고 실행만 해서, 여기서 안 보면 테스트의 타입 에러는 아무도 못 잡는다.
  // vitest.config.js는 allowJs가 꺼져서 적지 않아도 대상이 아니다.
  "exclude": ["node_modules", "dist"]
}
