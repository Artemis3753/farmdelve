{
  "compilerOptions": {
    // package.json의 "type": "module"(ESM) 규칙을 그대로 따른다.
    "module": "nodenext",
    // Node 26은 최신 문법을 다 읽으므로 인쇄본(js)을 옛 문법으로 낮출 필요가 없다.
    "target": "esnext",

    // 원고의 기준 폴더. 이 tsconfig가 있는 server 폴더를 기준으로 폴더 구조를 그대로 보존한다.
    "rootDir": ".",
    // 인쇄본 보관함. git에는 올리지 않는다.
    "outDir": "./dist",

    // 업계 기준선인 깐깐한 검수. 그 바깥의 추가 검사(noUncheckedIndexedAccess 등)는 켜지 않기로 했다.
    "strict": true,
    // 파일을 하나씩 바꾸는 동안 아직 .js인 파일도 함께 빌드한다. 전부 바꾼 뒤 끈다.
    "allowJs": true,

    // TS 7은 기본값이 빈 배열이라, 적지 않으면 process 같은 Node 전역을 모른다.
    "types": ["node"],
    // node_modules 속 남의 타입 설명서끼리의 충돌은 검사하지 않는다.
    "skipLibCheck": true
  },
  // 빌드에서 뺄 것 4개: 남의 코드, 인쇄본, 테스트 폴더, 테스트 설정 파일
  "exclude": ["node_modules", "dist", "test", "vitest.config.js"]
}
